<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="d886b83b-7755-4c8c-af25-d22445e31aa9" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Build</name>
  <description>Master build for SILConverters installers (x86 &amp; x64)</description>
  <settings>
    <options>
      <option name="artifactRules" value="output\x86\*.exe&#xA;output\x64\*.exe" />
      <option name="buildNumberPattern" value="%build.number%" />
      <option name="cleanBuild" value="true" />
    </options>
    <disabled-settings>
      <setting-ref ref="RUNNER_712" />
      <setting-ref ref="TRIGGER_31" />
    </disabled-settings>
    <parameters>
      <param name="BaseBuildDir" value="%system.teamcity.build.checkoutDir%build\" />
      <param name="OutputDir" value="%system.teamcity.build.checkoutDir%output\%system.teamcity.dotnet.platform%" />
      <param name="system.Configuration" value="Release" />
      <param name="system.SolutionDir" value="%system.teamcity.build.checkoutDir%\" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_712" name="run VsDevCmd.bat for SpellFixerEc &amp; SILOffice projects" type="simpleRunner">
        <parameters>
          <param name="script.content"><![CDATA[echo "C:\Program Files (x86)\Microsoft Visual Studio\2019\BuildTools\Common7\Tools\VsDevCmd.bat"
call "C:\Program Files (x86)\Microsoft Visual Studio\2019\BuildTools\Common7\Tools\VsDevCmd.bat"
rem cd "C:\Program Files (x86)\Microsoft Visual Studio\2019"
rem dir /s]]></param>
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_942" name="Build MSI x64" type="dotnet">
        <parameters>
          <param name="args"><![CDATA[-restore -noLogo
/p:Platform=x64]]></param>
          <param name="command" value="msbuild" />
          <param name="configuration" value="Release" />
          <param name="dotNetCoverage.dotCover.home.path" value="%teamcity.tool.JetBrains.dotCover.CommandLineTools.DEFAULT%" />
          <param name="msbuild.version" value="MSBuild_17_Windows" />
          <param name="paths" value="&quot;SEC VS2019.sln&quot;" />
          <param name="required.sdk" value="4.8" />
          <param name="targets" value="Build" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="RUNNER_941" name="Sign Exe x64" type="dotnet">
        <parameters>
          <param name="args"><![CDATA[-restore -noLogo
/p:Platform=x64
/p:TruncatedVersion=5.5]]></param>
          <param name="command" value="msbuild" />
          <param name="configuration" value="Release" />
          <param name="dotNetCoverage.dotCover.home.path" value="%teamcity.tool.JetBrains.dotCover.CommandLineTools.DEFAULT%" />
          <param name="msbuild.version" value="MSBuild_17_Windows" />
          <param name="paths"><![CDATA["Installer/SEC Setup 64bit/SEC Setup 64bit.wixproj"
"Installer/SetupSILConverters/SetupSILConverters.wixproj"]]></param>
          <param name="required.sdk" value="4.8" />
          <param name="targets" value="SignBuild" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="RUNNER_716" name="Build MSI x86" type="dotnet">
        <parameters>
          <param name="args"><![CDATA[-restore -noLogo
/p:Platform=x86]]></param>
          <param name="command" value="msbuild" />
          <param name="configuration" value="Release" />
          <param name="dotNetCoverage.dotCover.home.path" value="%teamcity.tool.JetBrains.dotCover.CommandLineTools.DEFAULT%" />
          <param name="msbuild.version" value="MSBuild_17_Windows" />
          <param name="paths" value="&quot;SEC VS2019.sln&quot;" />
          <param name="required.sdk" value="4.8" />
          <param name="targets" value="Build" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="RUNNER_937" name="Sign MSI &amp; Exe x86" type="dotnet">
        <parameters>
          <param name="args"><![CDATA[-restore -noLogo
/p:Platform=x86
/p:TruncatedVersion=5.5]]></param>
          <param name="command" value="msbuild" />
          <param name="configuration" value="Release" />
          <param name="dotNetCoverage.dotCover.home.path" value="%teamcity.tool.JetBrains.dotCover.CommandLineTools.DEFAULT%" />
          <param name="msbuild.version" value="MSBuild_17_Windows" />
          <param name="paths"><![CDATA["Installer/SEC Setup/SEC Setup.wixproj"
"Installer/SetupSILConverters/SetupSILConverters.wixproj"]]></param>
          <param name="required.sdk" value="4.8" />
          <param name="targets" value="SignBuild" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="SilConverters_Silconverters_HttpsGithubComSilnrsiSilconvertersRefsHeadsMaster" />
    </vcs-settings>
    <requirements>
      <equals id="RQ_127" name="teamcity.agent.name" value="ba-gen-w10-64-3" />
    </requirements>
    <build-triggers>
      <build-trigger id="TRIGGER_31" type="vcsTrigger">
        <parameters>
          <param name="branchFilter" value="+:*" />
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriodMode" value="DO_NOT_USE" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="perfmon" type="perfmon">
        <parameters>
          <param name="teamcity.perfmon.feature.enabled" value="true" />
        </parameters>
      </extension>
    </build-extensions>
  </settings>
</build-type>
 
