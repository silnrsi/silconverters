    <!-- RegisterForComInterop=true here in the pre-conversion project; SDK-style fails the build outright
         if RegisterForComInterop tries to run non-elevated, so it's replaced by the ExportAndRegisterTypeLibrary
         target below (same pattern already proven in encoding-converters-core's own SDK-style conversion). -->
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>..\..\output\x64\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;BUILD_FOR_OFF15</DefineConstants>
  </PropertyGroup>
  <!-- Replaces RegisterForComInterop=true (Debug|x64 only, matching the pre-conversion project exactly):
       TlbExp always runs (no registry access, needed by downstream WiX merge modules); RegAsm is best-effort
       local-dev-only registration, non-fatal if not elevated. Production COM registration for real end users
       is owned entirely by the WiX-authored registry entries in SCOffice13MM/SCOffice1364bitMM, not this. -->
  <Target Name="ExportAndRegisterTypeLibrary" AfterTargets="Build" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <PropertyGroup>
      <_TlbExpToolPath>$(TargetFrameworkSDKToolsDirectory)x64\TlbExp.exe</_TlbExpToolPath>
      <_RegAsmToolPath>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\RegAsm.exe</_RegAsmToolPath>
    </PropertyGroup>
    <Exec Command="&quot;$(_TlbExpToolPath)&quot; &quot;$(TargetPath)&quot; /out:&quot;$(TargetDir)$(TargetName).tlb&quot;" />
    <Exec Command="&quot;$(_RegAsmToolPath)&quot; &quot;$(TargetPath)&quot; /codebase /tlb:&quot;$(TargetDir)$(TargetName).tlb&quot;" ContinueOnError="WarnAndContinue" />
  </Target>
