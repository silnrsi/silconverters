<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{99140A5E-9BBF-4B8E-B466-FFAFC484B919}</ProjectGuid>
    <ApplicationIcon>TRFFC17.ICO</ApplicationIcon>
    <AssemblyName>ClipboardEC</AssemblyName>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ClipboardEC</RootNamespace>
    <StartupObject>ClipboardEC.FormClipboardEncConverter</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>..\..\output\x86\debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <BaseAddress>285212672</BaseAddress>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\x86\Release\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>true</Optimize>
    <DebugType>full</DebugType>
    <DefineConstants>TRACE</DefineConstants>
    <BaseAddress>285212672</BaseAddress>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>..\..\output\x64\Debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <BaseAddress>285212672</BaseAddress>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>true</Optimize>
    <DebugType>full</DebugType>
    <DefineConstants>TRACE</DefineConstants>
    <BaseAddress>285212672</BaseAddress>
  </PropertyGroup>
  <ItemGroup>
    <!-- nuget doesn't add the references to the csproj files properly for these; manually HintPath'd instead. -->
    <Reference Include="BackTranslationHelper">
      <HintPath>$(EcDistFilesPath)\win-$(Platform)\native\BackTranslationHelper.dll</HintPath>
    </Reference>
    <Reference Include="SpellingFixer30">
      <HintPath>$(EcDistFilesPath)\win-$(Platform)\native\SpellingFixer30.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="App.ico" />
    <Content Include="TRFFC17.ICO" />
    <None Include="app.config" />
    <None Include="app.manifest" />
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- These Update items restore metadata that default globbing (necessarily) drops. Most are cosmetic
         (SubType/DependentUpon just control Solution Explorer nesting and designer double-click behavior),
         but the EmbeddedResource DependentUpon below is load-bearing: ClipboardEncConverter.resx is the resx
         for class FormClipboardEncConverter (the class was renamed at some point without renaming the file),
         and ComponentResourceManager(typeof(FormClipboardEncConverter)) looks up its resources by the CLASS's
         full name. Without DependentUpon telling the manifest-name generator which .cs file's class to use,
         it falls back to naming the resource after the resx's own filename - "ClipboardEC.ClipboardEncConverter.resources"
         instead of "ClipboardEC.FormClipboardEncConverter.resources" - and every resources.GetObject(...) call
         in InitializeComponent (the icon, notably) throws MissingManifestResourceException at startup. -->
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="ClipboardEncConverter.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ClipboardEncConverter.Designer.cs">
      <DependentUpon>ClipboardEncConverter.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="ClipboardEncConverter.resx">
      <DependentUpon>ClipboardEncConverter.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <Compile Update="TranslationHelperForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="TranslationHelperForm.Designer.cs">
      <DependentUpon>TranslationHelperForm.cs</DependentUpon>
    </Compile>
    <Compile Update="ProcTypeMenuItem.cs">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Encoding-Converters-Core" Version="1.0.0" />
  </ItemGroup>
  <Import Project="$(SolutionDir)SharedItems.props" />
  <PropertyGroup>
    <PostBuildEvent>IF "$(Configuration)" == "Debug" goto nocopy
xcopy /y "$(TargetDir)*.*" "$(SolutionDir)output\$(Platform)\$(Configuration)\"
:nocopy</PostBuildEvent>
  </PropertyGroup>
</Project>
