<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{7580E2C0-F919-4FA5-AC2C-ADCAE4F8C14E}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SFMConv</RootNamespace>
    <AssemblyName>SFMConv</AssemblyName>
    <StartupObject>SFMConv.Program</StartupObject>
    <ApplicationIcon>TRFFC17.ICO</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>bin\$(Platform)\Debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>bin\$(Platform)\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- nuget doesn't add the references to the csproj files properly for these; manually HintPath'd instead. -->
    <Reference Include="SpellingFixer30">
      <HintPath>$(EcDistFilesPath)\win-$(Platform)\native\SpellingFixer30.dll</HintPath>
    </Reference>
    <Reference Include="System.Data" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization.Formatters.Soap" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
    <None Include="app.manifest" />
    <None Include="Images\RefreshDocViewHS.png" />
    <None Include="Images\openHS.GIF" />
    <None Include="Images\SaveUnicode.gif" />
    <None Include="Images\SaveLegacy.gif" />
    <None Include="Images\BreakpointHS.png" />
    <None Include="Images\Unicode openHS.gif" />
    <Content Include="TRFFC17.ICO" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Encoding-Converters-Core" Version="0.9.9" />
  </ItemGroup>
  <Import Project="$(SolutionDir)SharedItems.props" />
  <PropertyGroup>
    <PostBuildEvent>xcopy /y "$(TargetDir)*.*" "$(SolutionDir)output\$(Platform)\$(Configuration)\"</PostBuildEvent>
  </PropertyGroup>
</Project>
