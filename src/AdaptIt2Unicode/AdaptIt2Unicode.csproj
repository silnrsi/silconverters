<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{546F0AA8-5A2B-40BD-BB27-A55015F1DA1A}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AdaptIt2Unicode</RootNamespace>
    <AssemblyName>AdaptIt2Unicode</AssemblyName>
    <StartupObject>AdaptIt2Unicode.Program</StartupObject>
    <ApplicationIcon>TRFFC17.ICO</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
