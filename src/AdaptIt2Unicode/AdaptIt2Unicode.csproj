  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Encoding-Converters-Core" Version="0.9.9" />
  </ItemGroup>
  <PropertyGroup>
    <PostBuildEvent>xcopy /y "$(TargetDir)*.*" "$(SolutionDir)output\$(Platform)\$(Configuration)\"</PostBuildEvent>
  </PropertyGroup>
