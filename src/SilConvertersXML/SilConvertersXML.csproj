<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{46294EE5-E65C-485C-B88D-C4C95880281D}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SilConvertersXML</RootNamespace>
    <AssemblyName>SilConvertersXML</AssemblyName>
    <ApplicationIcon>TRFFC17.ICO</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>..\..\output\x86\debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\x86\release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>..\..\output\x64\Debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- nuget doesn't add the references to the csproj files properly for these; manually HintPath'd instead. -->
    <Reference Include="BackTranslationHelper">
      <HintPath>$(EcDistFilesPath)\win-$(Platform)\native\BackTranslationHelper.dll</HintPath>
    </Reference>
    <Reference Include="System.Data" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization.Formatters.Soap" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
    <None Include="app.manifest" />
    <Content Include="TRFFC17.ICO" />
  </ItemGroup>
  <ItemGroup>
    <!-- "Manual XPath Form.cs"'s class is XPathFilterForm (never renamed to match the file) - same
         load-bearing pattern as ClipboardEC's ClipboardEncConverter.cs/FormClipboardEncConverter: without
         DependentUpon here, the resx gets named after the FILE ("SilConvertersXML.Manual XPath Form.resources")
         instead of the CLASS ComponentResourceManager(typeof(XPathFilterForm)) actually looks up
         ("SilConvertersXML.XPathFilterForm.resources"), throwing MissingManifestResourceException at
         startup. Confirmed via the identical crash in ClipboardEC; see that project's csproj comment. -->
    <Compile Update="Manual XPath Form.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Manual XPath Form.Designer.cs">
      <DependentUpon>Manual XPath Form.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Manual XPath Form.resx">
      <DependentUpon>Manual XPath Form.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Encoding-Converters-Core" Version="0.9.9" />
  </ItemGroup>
  <Import Project="$(SolutionDir)SharedItems.props" />
  <PropertyGroup>
    <PostBuildEvent>IF "$(Configuration)" == "Debug" goto nocopy
xcopy /y "$(TargetDir)*.*" "$(SolutionDir)output\$(Platform)\$(Configuration)\"
:nocopy
		</PostBuildEvent>
  </PropertyGroup>
</Project>
