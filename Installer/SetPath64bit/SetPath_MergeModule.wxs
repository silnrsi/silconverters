<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Module Id="Set_PATH_Environment_Variable_64bit" Language="0" Version="1.0" Guid="{970F15FE-1712-4686-882A-F93874A1EE1F}" InstallerVersion="500"><SummaryInformation Keywords="MergeModule, MSI, PATH" Description="Sets the PATH Environment variable for Encoding Converters" Manufacturer="SIL International" />

        
    
            <StandardDirectory Id="CommonFiles64Folder">
                <Component Id="PATH" Guid="{0A0ABCDA-A90F-4207-818C-19C2FB83BA09}">
                    <Environment Id="PATH" Name="PATH" Action="set" System="yes" Part="first" Value="[CommonFiles64Folder]SIL" />
                    <!-- The next item is junk to make validation pass on ICE18. -->
                    <CreateFolder />
                </Component>
            </StandardDirectory>
        </Module>
</Wix>
