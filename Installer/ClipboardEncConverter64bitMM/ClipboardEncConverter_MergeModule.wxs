<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Module Id="ClipboardEncConverter4064bitMergeModule" Language="1033" Version="4.0.0.0" Guid="{C0AF5D35-7D08-409D-A6EA-24291DFDD109}" InstallerVersion="500"><SummaryInformation Description="Installer for the Clipboard EncConverter Plug-in" Keywords="Encoding Converters; Clipboard; SIL; Unicode" Manufacturer="SIL International" />

    

    <InstallExecuteSequence>
      <RemoveShortcuts Condition="Installed AND NOT UPGRADINGPRODUCTCODE AND REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  
      <Component Id="RegKey" Guid="{E0A39E6B-1238-4581-9147-CEB91166439A}" Directory="TARGETDIR">
        <RegistryValue Id="RegKey" Root="HKLM" Key="Software\SIL\SilEncConverters40\ClipboardEC" Value="" Type="string" KeyPath="yes" />
      </Component>
      <Directory Id="MergeRedirectFolder">

        <Component Id="ClipboardEC.exe" Guid="{2E4D0EE2-606C-401F-A1AF-8BD09DF48C27}">
          <File Id="ClipboardEC.exe" Name="ClipboardEC.exe" KeyPath="yes" Assembly=".net" AssemblyManifest="ClipboardEC.exe" AssemblyApplication="ClipboardEC.exe" Source="..\..\output\x64\release\ClipboardEC.exe" />
          <Shortcut Id="ClipboardEC.exe" Directory="SILConverters" Name="Clipboard EncConverter" Description="Start the Clipboard EncConverter program" IconIndex="0" Show="normal" Target="[#ClipboardEC.exe]" WorkingDirectory="MergeRedirectFolder" Advertise="no" />
        </Component>

        <Component Id="ClipboardEC.exe.config" Guid="{8358FB12-D823-40A7-BD5B-94155CF7801C}">
          <File Id="ClipboardEC.exe.config" Name="ClipboardEC.exe.config" Vital="yes" KeyPath="yes" Source="..\..\output\x64\release\ClipboardEC.exe.config" />
        </Component>

      </Directory>

      <StandardDirectory Id="ProgramMenuFolder">
          <Directory Id="SILConverters" Name="SIL Converters" />
        </StandardDirectory>

    </Module>
</Wix>
