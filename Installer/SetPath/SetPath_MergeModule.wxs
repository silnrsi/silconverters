<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Module Id="Set_PATH_Environment_Variable" Language="0" Version="1.0" Guid="CE24DB4B-6A1C-4BEC-91A8-432FB75AECE7" InstallerVersion="500"><SummaryInformation Keywords="MergeModule, MSI, PATH" Description="Sets the PATH Environment variable for Encoding Converters" Manufacturer="SIL International" />

        
    
            <StandardDirectory Id="CommonFilesFolder">
                <Component Id="PATH" Guid="{0A0ABCDA-A90F-4207-818C-19C2FB83BA09}">
                    <Environment Id="PATH" Name="PATH" Action="set" System="yes" Part="first" Value="[CommonFilesFolder]SIL" />
                    <!-- The next item is junk to make validation pass on ICE18. -->
                    <CreateFolder />
                </Component>
            </StandardDirectory>
        </Module>
</Wix>
