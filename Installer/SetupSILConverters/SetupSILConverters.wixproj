<Project Sdk="WixToolset.Sdk/6.0.2" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <OutputType>Bundle</OutputType>
    <OutputName>SetupSILConverters</OutputName>
    <ProjectGuid>496c70f6-d12a-42c9-a892-ace1c6981f52</ProjectGuid>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>ApplicationName=SILConverters;SafeApplicationName=SILConverters;TruncatedVersion=6.0;VersionNumber=6.0.0.0;UpgradeCode=8A50226C-84D0-4CAF-AF8F-B0284643C415;Year=2026;Manufacturer=SIL International;EcDistFilesPath=$(EcDistFilesPath)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>ApplicationName=SILConverters;SafeApplicationName=SILConverters;TruncatedVersion=6.0;VersionNumber=6.0.0.0;UpgradeCode=0F7D5D72-E9F3-40BB-9748-D388C70096CD;Year=2026;Manufacturer=SIL International;EcDistFilesPath=$(EcDistFilesPath)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="BundleTheme.xml" />
    <Content Include="bundle_background.bmp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Encoding-Converters-Core" Version="1.0.2" GeneratePathProperty="true" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Bal.wixext" Version="6.0.2" />
  </ItemGroup>
  <!-- The MSI must be signed BEFORE this bundle compiles, because CoreCompile embeds whatever MSI is sitting in
       output\<platform>\ at that moment into the bundle's attached container; signing the loose MSI afterward
       never reaches the embedded copy. Found in the sibling OneStoryEditor build (same structure) on 2026-09-30:
       the bundle exe and engine were signed but the MSI extracted from inside it had no signature. So for
       SignBuild-driven builds (TeamCity), build and sign the matching MSI project first.
       Skipped under GitHub Actions: that workflow signs with sillsdev/codesign/trusted-signing-action instead of
       SignBuild, and orders MSI signing before the bundle rebuild itself (see .github/workflows/build.yml). Running
       this there would also re-trigger the MSI project's CopyMsiToOutput (SkipUnchangedFiles="false"), overwriting
       an already-signed output\ MSI with the unsigned bin\ copy. Release-only so local Debug builds don't need
       signing tooling. -->
  <Target Name="EnsureSignedMsiPayload" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release' and '$(GITHUB_ACTIONS)' != 'true'">
    <PropertyGroup>
      <MsiProject Condition="'$(Platform)' == 'x64'">..\SEC Setup 64bit\SEC Setup 64bit.wixproj</MsiProject>
      <MsiProject Condition="'$(Platform)' != 'x64'">..\SEC Setup\SEC Setup.wixproj</MsiProject>
    </PropertyGroup>
    <MSBuild Projects="$(MsiProject)" Targets="Build;SignBuild" Properties="Configuration=$(Configuration);Platform=$(Platform);SolutionDir=$(SolutionDir)" />
  </Target>
  <Target Name="PostBuildCopy" AfterTargets="Build">
    <PropertyGroup>
      <CmdLineArgs>"$(TargetPath)" "$(SolutionDir)output\$(PlatformName)\$(TargetName)_$(TruncatedVersion)_$(PlatformName)$(TargetExt)"</CmdLineArgs>
    </PropertyGroup>
    <Message Text="CmdLineArgs: $(CmdLineArgs), TruncatedVersion: $(TruncatedVersion), ExeFile: $(ExeFile), SolutionDir: $(SolutionDir), BaseBuildDir: $(BaseBuildDir), OutputDir: $(OutputDir), BaseBuildArgs: $(BaseBuildArgs), BuildingInsideVisualStudio: $(BuildingInsideVisualStudio), MSBuildStartupDirectory: $(MSBuildStartupDirectory)" />
    <Exec Command="copy $(CmdLineArgs)" />
  </Target>
  <Target Name="SignBuild">
    <PropertyGroup>
      <ExeFile>$(TargetName)_$(TruncatedVersion)_$(PlatformName)$(TargetExt)</ExeFile>
      <BaseBuildDir>$(SolutionDir)build\</BaseBuildDir>
      <OutputDir>$(SolutionDir)output\$(PlatformName)\</OutputDir>
      <!-- wix.exe from the WixToolset.Sdk package (net472 layout, i.e. when run under full-framework MSBuild.exe)
           is used to detach/reattach the bundle engine for signing, so the build agent doesn't need WiX v3's
           insignia.exe on its PATH. -->
      <WixExe>$(WixBinDir)x86\wix.exe</WixExe>
      <BaseBuildArgs>"$(OutputDir)$(ExeFile)" UseInsignia "$(WixExe)"</BaseBuildArgs>
    </PropertyGroup>
    <Error Condition="!Exists('$(WixExe)')" Text="wix.exe not found at '$(WixExe)'; can't detach/reattach the bundle engine for signing." />
    <Message Text="TruncatedVersion: $(TruncatedVersion), ExeFile: $(ExeFile), SolutionDir: $(SolutionDir), BaseBuildDir: $(BaseBuildDir), OutputDir: $(OutputDir), BaseBuildArgs: $(BaseBuildArgs), BuildingInsideVisualStudio: $(BuildingInsideVisualStudio), MSBuildStartupDirectory: $(MSBuildStartupDirectory)" />
    <Exec WorkingDirectory="$(BaseBuildDir)" Command="$(BaseBuildDir)buildBaseInstaller.bat $(BaseBuildArgs)" />
  </Target>
</Project>