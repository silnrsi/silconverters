<Project Sdk="WixToolset.Sdk/6.0.2" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <OutputType>Package</OutputType>
    <OutputName>SetupSILConverters_x64</OutputName>
    <ProjectGuid>{69CB9E94-E875-4B29-AB69-3BBFE8D467E8}</ProjectGuid>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DefineConstants>Debug</DefineConstants>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>EcDistFilesPath=$(EcDistFilesPath);$(DefineConstants)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- EcUI.wxs is deliberately NOT included here: it's dead source (no Product.wxs/*.wxs file references it;
         the actual UI comes from the standard WixUI_FeatureTree set via WixToolset.UI.wixext). Kept as an
         explicit list (EnableDefaultCompileItems=false above) so default globbing can't sweep it back in. -->
    <Compile Include="EcActions.wxs" />
    <Compile Include="EcFeatures.wxs" />
    <Compile Include="EcFiles.wxs" />
    <Compile Include="EcMergeModules.wxs" />
    <Compile Include="Product.wxs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Encoding-Converters-Core" Version="0.9.9" GeneratePathProperty="true" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
  <Target Name="SignBuild">
    <PropertyGroup>
      <MsiFile>$(TargetFileName)</MsiFile>
      <SolutionDir>$(MSBuildStartupDirectory)\</SolutionDir>
      <BaseBuildDir>$(SolutionDir)build\</BaseBuildDir>
      <OutputDir>$(SolutionDir)output\$(PlatformName)\</OutputDir>
      <BaseBuildArgs>"$(OutputDir)$(MsiFile)"</BaseBuildArgs>
    </PropertyGroup>
    <Message Text="MsiFile: $(MsiFile), SolutionDir: $(SolutionDir), BaseBuildDir: $(BaseBuildDir), OutputDir: $(OutputDir), BaseBuildArgs: $(BaseBuildArgs), BuildingInsideVisualStudio: $(BuildingInsideVisualStudio), MSBuildStartupDirectory: $(MSBuildStartupDirectory)" />
    <Exec WorkingDirectory="$(BaseBuildDir)" Command="$(BaseBuildDir)buildBaseInstaller.bat $(BaseBuildArgs)" />
  </Target>
  <Target Name="CopyMsiToOutput" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(SolutionDir)output\$(PlatformName)\$(TargetFileName)" SkipUnchangedFiles="false" />
  </Target>
</Project>
