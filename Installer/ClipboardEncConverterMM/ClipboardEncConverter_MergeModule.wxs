<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Module Id="ClipboardEncConverter40MergeModule" Language="1033" Version="4.0.0.0" Guid="12b67fc1-e9fc-4337-8901-8aec7f35e767" InstallerVersion="500"><SummaryInformation Description="Installer for the Clipboard EncConverter Plug-in" Keywords="Encoding Converters; Clipboard; SIL; Unicode" Manufacturer="SIL International" />

    

    <InstallExecuteSequence>
      <RemoveShortcuts Condition="Installed AND NOT UPGRADINGPRODUCTCODE AND REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  
      <Component Id="RegKey" Guid="{44003A14-73D6-4F94-A932-C9E8E2ACF44F}" Directory="TARGETDIR">
        <RegistryValue Id="RegKey" Root="HKLM" Key="Software\SIL\SilEncConverters40\ClipboardEC" Value="" Type="string" KeyPath="yes" />
      </Component>
      <Directory Id="MergeRedirectFolder">

        <Component Id="ClipboardEC.exe" Guid="{A031D80B-38EA-48C6-99A9-F758BDF04D93}">
          <File Id="ClipboardEC.exe" Name="ClipboardEC.exe" KeyPath="yes" Assembly=".net" AssemblyManifest="ClipboardEC.exe" AssemblyApplication="ClipboardEC.exe" Source="..\..\output\x86\release\ClipboardEC.exe" />
          <Shortcut Id="ClipboardEC.exe" Directory="SILConverters" Name="Clipboard EncConverter" Description="Start the Clipboard EncConverter program" IconIndex="0" Show="normal" Target="[#ClipboardEC.exe]" WorkingDirectory="MergeRedirectFolder" Advertise="no" />
        </Component>

        <Component Id="ClipboardEC.exe.config" Guid="{8358FB12-D823-40A7-BD5B-94155CF7801C}">
          <File Id="ClipboardEC.exe.config" Name="ClipboardEC.exe.config" Vital="yes" KeyPath="yes" Source="..\..\output\x86\release\ClipboardEC.exe.config" />
        </Component>

      </Directory>

      <StandardDirectory Id="ProgramMenuFolder">
          <Directory Id="SILConverters" Name="SIL Converters" />
        </StandardDirectory>

    </Module>
</Wix>
