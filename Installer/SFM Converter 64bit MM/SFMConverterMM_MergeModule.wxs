<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Module Id="SFM_Converter_64bit_MM" Language="1033" Version="4.0.0.0" Guid="{13E3C3F6-4325-4B15-9FA4-6D0C36242CCC}" InstallerVersion="500"><SummaryInformation Manufacturer="SIL International" Description="Convert SFM documents using SILConverters" Keywords="SFM, TECkit, Encoding Conversion" />

    

    <InstallExecuteSequence>
      <RemoveShortcuts Condition="Installed AND NOT UPGRADINGPRODUCTCODE AND REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  
      <Directory Id="MergeRedirectFolder">

        <Component Id="SFMConv.exe" Guid="{51C0BB33-5629-4AA5-BDE0-71D203C448BC}">
          <File Id="SFMConv.exe" Name="SFMConv.exe" KeyPath="yes" Assembly=".net" AssemblyManifest="SFMConv.exe" AssemblyApplication="SFMConv.exe" Source="..\..\output\x64\release\SFMConv.exe" />
          <Shortcut Id="SFMConv.exe" Directory="SILConverters" Name="Bulk SFM Converter" Description="Convert your SFM documents with converters in the system repository" IconIndex="0" Show="normal" Target="[#SFMConv.exe]" WorkingDirectory="MergeRedirectFolder" Advertise="no" />
        </Component>

        <!-- Placeholder shared with ScHelpMM's own "SCHelp" directory: same Id merges with ScHelpMM.msm's real
             declaration at final MSI link time (both modules always ship together, see EcMergeModules.wxs). -->
        <Directory Id="SCHelp" Name="Help" />

      </Directory>

      <Directory Id="CscHelp" Name="Help">
        <Component Id="HelpforConsistentSpellFixer.pdf" Guid="{AB9C4C65-9AC9-4712-9B42-BF534DD5A7B1}">
          <File Id="HelpforConsistentSpellFixer.pdf" Name="Help for ConsistentSpellFixer.pdf" KeyPath="yes" Source="..\SFM Converter MM\redist\Help for ConsistentSpellFixer.pdf" />
          <Shortcut Id="HelpforConsistentSpellFixer.pdf" Directory="ScHelp" Name="Help for ConsistentSpellFixer" Description="Help files for using the ConsistentSpellFixer for correcting or unifying spelling of words that have multiple, valid ways of being spelled" Show="normal" Target="[#HelpforConsistentSpellFixer.pdf]" WorkingDirectory="SCHelp" Advertise="no" />
        </Component>
      </Directory>

      <StandardDirectory Id="ProgramMenuFolder">
          <Directory Id="SILConverters" Name="SIL Converters">
            <Directory Id="ScHelp" Name="Help" />
          </Directory>
        </StandardDirectory>

    </Module>
</Wix>
